# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงจาก Supabase
# ดูได้ที่: Supabase Dashboard → ปุ่ม Connect (บนหัวโปรเจกต์) → แท็บ ORMs → Prisma
# ใช้ Session pooler (port 5432) สำหรับ prisma db push
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
